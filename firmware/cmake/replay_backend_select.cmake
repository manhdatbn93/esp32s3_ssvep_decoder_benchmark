# Map -DTARGET_BACKEND=<name> to SMOKE_ENABLE_* for replay_fw builds.
# Example: idf.py -DTARGET_BACKEND=ccnn_int8 build
if(NOT DEFINED TARGET_BACKEND)
    get_property(_TB CACHE TARGET_BACKEND PROPERTY VALUE)
    if(_TB)
        set(TARGET_BACKEND "${_TB}")
    endif()
endif()
if(NOT DEFINED TARGET_BACKEND OR "${TARGET_BACKEND}" STREQUAL "")
    return()
endif()

string(TOLOWER "${TARGET_BACKEND}" _TARGET_BACKEND)

set(SMOKE_ENABLE_CCA OFF CACHE BOOL "" FORCE)
set(SMOKE_ENABLE_FBCCA OFF CACHE BOOL "" FORCE)
set(SMOKE_ENABLE_MSI OFF CACHE BOOL "" FORCE)
set(SMOKE_ENABLE_TRCA OFF CACHE BOOL "" FORCE)
set(SMOKE_ENABLE_EEGNET_F32 OFF CACHE BOOL "" FORCE)
set(SMOKE_ENABLE_EEGNET_INT8 OFF CACHE BOOL "" FORCE)
set(SMOKE_ENABLE_CCNN_F32 OFF CACHE BOOL "" FORCE)
set(SMOKE_ENABLE_CCNN_INT8 OFF CACHE BOOL "" FORCE)
set(SMOKE_ENABLE_CONVCA_F32 OFF CACHE BOOL "" FORCE)
set(SMOKE_ENABLE_FBTCNN_F32 OFF CACHE BOOL "" FORCE)
set(SMOKE_ENABLE_FBTCNN_INT8 OFF CACHE BOOL "" FORCE)

if(_TARGET_BACKEND STREQUAL "cca")
    set(SMOKE_ENABLE_CCA ON CACHE BOOL "" FORCE)
elseif(_TARGET_BACKEND STREQUAL "fbcca")
    set(SMOKE_ENABLE_FBCCA ON CACHE BOOL "" FORCE)
elseif(_TARGET_BACKEND STREQUAL "msi")
    set(SMOKE_ENABLE_MSI ON CACHE BOOL "" FORCE)
elseif(_TARGET_BACKEND STREQUAL "trca")
    set(SMOKE_ENABLE_TRCA ON CACHE BOOL "" FORCE)
elseif(_TARGET_BACKEND STREQUAL "eegnet_f32" OR _TARGET_BACKEND STREQUAL "eegnet_float32")
    set(SMOKE_ENABLE_EEGNET_F32 ON CACHE BOOL "" FORCE)
elseif(_TARGET_BACKEND STREQUAL "eegnet_int8" OR _TARGET_BACKEND STREQUAL "eegnet_i8")
    set(SMOKE_ENABLE_EEGNET_INT8 ON CACHE BOOL "" FORCE)
elseif(_TARGET_BACKEND STREQUAL "ccnn_f32" OR _TARGET_BACKEND STREQUAL "ccnn_float32")
    set(SMOKE_ENABLE_CCNN_F32 ON CACHE BOOL "" FORCE)
elseif(_TARGET_BACKEND STREQUAL "ccnn_int8" OR _TARGET_BACKEND STREQUAL "ccnn_i8")
    set(SMOKE_ENABLE_CCNN_INT8 ON CACHE BOOL "" FORCE)
elseif(_TARGET_BACKEND STREQUAL "convca_f32" OR _TARGET_BACKEND STREQUAL "convca_float32")
    set(SMOKE_ENABLE_CONVCA_F32 ON CACHE BOOL "" FORCE)
elseif(_TARGET_BACKEND STREQUAL "fbtcnn_f32" OR _TARGET_BACKEND STREQUAL "fbtcnn_float32")
    set(SMOKE_ENABLE_FBTCNN_F32 ON CACHE BOOL "" FORCE)
elseif(_TARGET_BACKEND STREQUAL "fbtcnn_int8" OR _TARGET_BACKEND STREQUAL "fbtcnn_i8")
    set(SMOKE_ENABLE_FBTCNN_INT8 ON CACHE BOOL "" FORCE)
else()
    message(FATAL_ERROR "Unknown TARGET_BACKEND=${TARGET_BACKEND}. "
        "Expected cca, fbcca, msi, trca, eegnet_f32, eegnet_int8, ccnn_f32, "
        "ccnn_int8, convca_f32, fbtcnn_f32, fbtcnn_int8.")
endif()

set(_ENABLED_FLAGS "")
if(SMOKE_ENABLE_CCA)
    list(APPEND _ENABLED_FLAGS "CCA")
endif()
if(SMOKE_ENABLE_FBCCA)
    list(APPEND _ENABLED_FLAGS "FBCCA")
endif()
if(SMOKE_ENABLE_MSI)
    list(APPEND _ENABLED_FLAGS "MSI")
endif()
if(SMOKE_ENABLE_TRCA)
    list(APPEND _ENABLED_FLAGS "TRCA")
endif()
if(SMOKE_ENABLE_EEGNET_F32)
    list(APPEND _ENABLED_FLAGS "EEGNet-f32")
endif()
if(SMOKE_ENABLE_EEGNET_INT8)
    list(APPEND _ENABLED_FLAGS "EEGNet-int8")
endif()
if(SMOKE_ENABLE_CCNN_F32)
    list(APPEND _ENABLED_FLAGS "CCNN-f32")
endif()
if(SMOKE_ENABLE_CCNN_INT8)
    list(APPEND _ENABLED_FLAGS "CCNN-int8")
endif()
if(SMOKE_ENABLE_CONVCA_F32)
    list(APPEND _ENABLED_FLAGS "ConvCA-f32")
endif()
if(SMOKE_ENABLE_FBTCNN_F32)
    list(APPEND _ENABLED_FLAGS "FBtCNN-f32")
endif()
if(SMOKE_ENABLE_FBTCNN_INT8)
    list(APPEND _ENABLED_FLAGS "FBtCNN-int8")
endif()
string(JOIN ", " _ENABLED_FLAGS_STR ${_ENABLED_FLAGS})
message(STATUS "replay_fw: TARGET_BACKEND=${TARGET_BACKEND} enabled=${_ENABLED_FLAGS_STR}")
