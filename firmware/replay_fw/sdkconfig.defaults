# ESP32-S3 target. Applied only when sdkconfig does not already exist.
CONFIG_IDF_TARGET="esp32s3"

# Reference ESP32-S3 performance configuration.
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240 is generated from this choice.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Large app partition (see partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# OPI PSRAM. The published module is ESP32-S3-WROOM-2-N32R8V.
# Required for DL backends that need large tensor arenas.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Flash size: 32 MB module (partitions.csv needs ~15 MB).
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# Disable task WDT during long smoke tests (CCA forward can take >5s).
CONFIG_ESP_TASK_WDT_INIT=n

# Main task stack: CCA/FBCCA/MSI forward and boot smoke (smoke_dispatch) run on
# app_main before Wi-Fi. 16 KB was marginal for MSI Jacobi + margins; 32 KB is
# safer and avoids stack smash into heap metadata (TLSF malloc crash after smoke).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# UART RES_PROFILE lines. Field definitions: paper_reproduction/evidence/table5/README.md
CONFIG_REPLAY_RESOURCE_PROFILE=y

# Skip ~5s embedded vector smoke at boot; go straight to Wi-Fi + TCP replay.
# Re-enable via menuconfig: Replay WiFi TCP -> "Run embedded smoke tests at boot"
CONFIG_REPLAY_BOOT_SMOKE=n
